DirectoryIndex index.php
Options -Indexes
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # آدرس‌های قدیمی به نسخهٔ تمیز منتقل شوند.
  RewriteCond %{THE_REQUEST} \s/+blog\.php[\s?] [NC]
  RewriteRule ^blog\.php$ /blog [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+post\.php\?slug=([^&\s]+) [NC]
  RewriteRule ^post\.php$ /blog/%1? [R=301,L,NE]

  # مسیرهای خوانا به فایل‌های PHP داخلی نگاشت شوند.
  RewriteRule ^blog/?$ blog.php [L,QSA]
  RewriteRule ^blog/([A-Za-z0-9-]+)/?$ post.php?slug=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# فشرده‌سازی و کش سبک برای فایل‌های استاتیک (در صورت وجود ماژول)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

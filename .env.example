# آدرس کامل دامنه‌ی سایت (برای canonical، Open Graph، sitemap و robots).
# نمونه را کپی کنید به .env.local و مقدار واقعی را بگذارید.
NEXT_PUBLIC_SITE_URL=https://your-domain.ir

# ---- پنل ادمین ----
# نام‌کاربری و رمز عبور ادمین اولیه. فقط در «نخستین اجرا» (وقتی دیتابیس خالی است)
# برای ساخت کاربر ادمین استفاده می‌شوند. پس از ساخت، تغییرشان در env اثری بر
# کاربر موجود ندارد.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# کلید امضای کوکی نشست. حتماً در تولید یک مقدار تصادفی و طولانی بگذارید.
# نمونه‌ی تولید: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=CHANGE_ME_USE_AT_LEAST_48_RANDOM_BYTES

# اگر سایت روی HTTPS است این را دست نزنید. فقط اگر روی HTTP بدون SSL اجرا می‌کنید
# و لاگین ادمین کار نمی‌کند، مقدار را false کنید.
# COOKIE_SECURE=false
